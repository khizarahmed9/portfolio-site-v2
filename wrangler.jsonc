{
  "name": "portfoliosite",
  "compatibility_date": "2026-09-30",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // unmatched paths get 404.html with a 404 status
    "not_found_handling": "404-page",
    // only these hit the worker first (curl text view, markdown for agents); every other path is served straight from assets
    "run_worker_first": ["/", "/index.md", "/llms.txt"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
